rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write only their own document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Username -> email lookup for login (username + password).
    // Anyone can read (needed to log in). A username can only be claimed once,
    // by the account it points to, and can't be taken over later. It is
    // released only when that account is deleted.
    match /usernameLookup/{username} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // All-time leaderboard. Anyone can read; each user writes only their own
    // entry, and the points can't grow faster than the app can award them:
    //  - listening: 2 points per minute since the last update (+ small margin)
    //  - badges: at most the sum of all badge points (9500) and 35 badges
    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && validEntry()
        && request.resource.data.listeningPoints <= 200;
      allow update: if isOwner(userId)
        && validEntry()
        && request.resource.data.listeningPoints <= previousListeningPoints() + maxNewListeningPoints();
      allow delete: if isOwner(userId);

      function validEntry() {
        let d = request.resource.data;
        return d.keys().hasOnly(['displayName', 'points', 'listeningPoints', 'badgePoints', 'badgeCount', 'updatedAt'])
          && d.displayName is string && d.displayName.size() <= 40
          && d.listeningPoints is int && d.listeningPoints >= 0
          && d.badgePoints is int && d.badgePoints >= 0 && d.badgePoints <= 9500
          && d.badgeCount is int && d.badgeCount >= 0 && d.badgeCount <= 35
          && d.points == d.listeningPoints + d.badgePoints
          && d.updatedAt == request.time;
      }

      function previousListeningPoints() {
        return resource.data.get('listeningPoints', resource.data.get('points', 0));
      }

      function maxNewListeningPoints() {
        let last = resource.data.get('updatedAt', request.time);
        let minutes = (request.time.toMillis() - last.toMillis()) / 60000;
        return 2 * math.ceil(minutes) + 4;
      }
    }
  }
}
