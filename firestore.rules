rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write only their own document (uid must match auth.uid)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Username -> email lookup for login (username + password). Read by anyone for login; only authenticated can write (on register).
    match /usernameLookup/{username} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    // Leaderboard: anyone can read (top 10); users can write only their own doc (userId = auth.uid).
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
